package(default_visibility = ["//visibility:public"])

constraint_setting(name = "target_variant")

constraint_value(
    name = "variant_linux",
    constraint_setting = ":target_variant",
)

constraint_value(
    name = "variant_windows",
    constraint_setting = ":target_variant",
)

config_setting(
    name = "on_linux",
    constraint_values = [":variant_linux"],
)

config_setting(
    name = "on_windows",
    constraint_values = [":variant_windows"],
)

platform(
    name = "linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":variant_linux",
    ],
)

platform(
    name = "windows",
    constraint_values = [
        "@platforms//os:linux", # I know, it's just for simulation
        "@platforms//cpu:x86_64",
        ":variant_windows",
    ],
)
